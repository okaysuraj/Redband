# Copy to .env for Compose; also export the backend settings in your shell.
# For production, use APP_ENV=production and a TLS-enabled PostgreSQL URL.
# DATABASE_URL is required in every environment; PostgreSQL is the only database.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://redband:redband@127.0.0.1:5432/redband
# Keep the password in DATABASE_URL in sync if you change this local value.
POSTGRES_PASSWORD=redband
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
AUTO_CREATE_SCHEMA=false
FIREBASE_PROJECT_ID=
# Backend only: a service-account JSON value OR GOOGLE_APPLICATION_CREDENTIALS path.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
